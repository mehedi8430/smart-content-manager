// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Define Prisma schema (User, Campaign, Post, AiOutput, ChatSession, ChatMessage)  
model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  refreshToken String?
  campaigns    Campaign[]
  createdAt    DateTime   @default(now())
}

model Campaign {
  id           String        @id @default(uuid())
  name         String
  description  String?
  userId       String
  user         User          @relation(fields: [userId], references: [id])
  posts        Post[]
  outputs      AiOutput[]
  chatSessions ChatSession[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

// Delete strategy: Cascade delete
// When a Campaign is deleted, all associated Posts and AiOutputs are automatically deleted.
// This is acceptable pre-launch for simplicity. If needed later, we can implement a
// soft-delete pattern or a force-delete endpoint with conflict checking.

model Post {
  id          String    @id @default(uuid())
  title       String
  description String?   @db.Text
  status      String    @default("todo") // todo | in_progress | done
  order       Int       @default(0)
  dueDate     DateTime?
  campaignId  String
  campaign    Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model AiOutput {
  id         String   @id @default(uuid())
  type       String // ad | caption | email
  title      String?
  prompt     String
  tone       String?
  content    String   @db.Text
  status     String   @default("completed") // pending | completed | failed
  model      String?
  tokensUsed Int?
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ChatSession {
  id         String        @id @default(uuid())
  userId     String
  campaignId String? // nullable: null = general session, set = campaign-scoped copilot
  campaign   Campaign?     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  title      String? // auto-derived from first user message, shown in sidebar
  messages   ChatMessage[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt // drives "most recent first" sidebar ordering
}

model ChatMessage {
  id        String      @id @default(uuid())
  role      String // user | assistant
  content   String      @db.Text
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())
}
